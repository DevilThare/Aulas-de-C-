void Button1Click(object sender, EventArgs e)
		{
			
			// 1. Obtendo dados com segurança
			int altura = int.Parse(textBox1.Text); 
			int	comprimento = int.Parse(textBox2.Text);
			int largura = int.Parse(textBox3.Text);


			int volume = altura * largura * comprimento;
			double taxaBase = 57.99;
			double porcentagemAdicional = 0;
			double taxaFixa = 0;

			// 2. Logica do IF
			if (volume > 250) {
    			porcentagemAdicional = 0.60;
    			taxaFixa = 450;
			} 
			else if (volume > 100) {
   				porcentagemAdicional = 0.40;
    			taxaFixa = 0;
			} 
			else if (volume > 50) {
    			porcentagemAdicional = 0.20;
    			taxaFixa = 0;
			}
			else {
			    porcentagemAdicional = 0;
			    taxaFixa = 0;
			}

			// 3. Cálculos Centralizados
			double valorBase = (volume * taxaBase) + taxaFixa;
			double valorAdicional = valorBase * porcentagemAdicional;
			double imposto = (valorBase + valorAdicional) * 0.22;
			double valorSemImposto = valorBase + valorAdicional;
			double valorTotal = valorSemImposto + imposto;
			
			// 4. Exibição dos dados
			label4.Text = "Valor Base: " + valorBase.ToString("C");
			label5.Text = "Adicional: " + valorAdicional.ToString("C");
			label6.Text = "Taxa Fixa: " + taxaFixa.ToString("C");
			label7.Text = "Subtotal (sem imposto): " + valorSemImposto.ToString("C");
			label8.Text = "Imposto (22%): " + imposto.ToString("C");
			label9.Text = "Valor Total: " + valorTotal.ToString("C");
			textBox4.Text = volume.ToString();
			}
		
